// CD test-front → agd-dev. Params: VERSION, ENVIRONMENT.
pipeline {
  agent any
  stages {
    stage('deploy') {
      steps {
        withCredentials([file(credentialsId: 'kind-kubeconfig', variable: 'KCFG')]) {
          sh '''
            set -e
            IMG="ghcr.io/ingeniods/test-front:${VERSION}"
            docker image inspect "$IMG" >/dev/null 2>&1 && \
              docker save "$IMG" | docker exec -i agd-control-plane ctr -n k8s.io images import - || true
            export KUBECONFIG="$KCFG"
            kubectl -n agd-dev set image deployment/test-front app="$IMG"
            kubectl -n agd-dev rollout status deployment/test-front --timeout=180s
          '''
        }
      }
    }
  }
}
